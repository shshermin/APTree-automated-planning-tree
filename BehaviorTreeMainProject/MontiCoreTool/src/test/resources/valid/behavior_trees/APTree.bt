

BehaviorTree APTree {
    Root FlowNode mainnode {
        ALL
        ALLFLOW 
        NodeGraph FirstGraph {    
            FlowNode plateseq {
                PDDLPlanning Service mypddlplanner1 ENHSP
                ALL
                ALLACTION
                NodeGraph mypddlplanner1result {
                    Action PickUpHL pickup1 (lp1 fp1 r1) @PickUpMLSubtree {
                       --[MEETS]--> placeBeam1;
                    }
                    Action PlaceHL placeBeam1 (lp1 pr1 r1) @PlaceMLSubtree
                }
            } 
            FlowNode bemasseq {
                PDDLPlanning Service mypddlplanner1 ENHSP
                ANY
                ALLACTION
                NodeGraph secondnodegraph{
                            Action PickUpHL pickuphl2 (beam1 position3 robot1) { 
                                --[MEETS]--> placeBeam1;
                            }
                            Action PlaceHL placehl3 (beam1 pr1 robot1) 
                            Action PickUpHL pickuphl3 (beam2 fp3 robot1) { 
                                --[MEETS]--> placehl3;
                            }
                            Action PlaceHL placehl3 (beam2 pr2 robot1) 
                }
                        
            } 
        }
    }
}



