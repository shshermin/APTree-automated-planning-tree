BehaviorTree MyRobotTree {
  root Sequence  {    
    Sequence {
      Action PickUpPlate1 
      Action PlacePlate1
    }   
    Parallel {
      Sequence {
        Action PickUpBeam1 {
          Decorator GripperEmpty
        }
        Action PlaceBeam1
      }
      Sequence {
        Action PickUpBeam2 
        Action PlaceBeam2 
      }
    }
  }
}