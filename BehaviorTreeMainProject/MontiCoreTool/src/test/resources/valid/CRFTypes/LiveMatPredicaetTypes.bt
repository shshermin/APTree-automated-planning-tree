// Predicate definition

Define Predicate Holding {
  item : Element
  agent : Agent
}

Define Predicate AtPlace {
  item : Element
  loc : Location
}


Define Predicate IsAt {
    myObject : Element
    location : Location
}

Define Predicate AtAgent {
    agent : Agent
    location : Location
}

Define Predicate HasTool {
    agent : Agent
    tool : Tool
}


Define Predicate Clear {
    myObject : Element
}

Define Predicate OnTop {
    myObject1 : Element
    myObject2 : Element
}

Define Predicate AllSet {
    lay : Layer
    mod : Module
}

Define Predicate BelongsToLayer {
    myObject : Element
    lay : Layer
}

Define Predicate BelongsToModule {
    myObject : Element
    mod : Module
}

Define Predicate PositionFree {
    pos : Location
}

Define Predicate Stacked {
    myObject : Element
}

Define Predicate Glued {
    myObject : Element
}

Define Predicate Nailed {
    myObject : Element
}
