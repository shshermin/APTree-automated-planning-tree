// 5. Action Type Definition (General Template)
Define Action PickUpHL {
    ActLevel: HighLevel
    Properties {
        objToPick: Element
        objLoc: Location
        client: Robot
    }
    Preconditions {
        atplace(objToPick, objLoc)
        !holding(client, objToPick)   
    }    
    Effects {
        holding(client, objToPick)
    }   
}

Define Action PlaceHL {
    ActLevel: HighLevel
    Properties {
        objToPlace: Element
        objLoc: Location
        client: Robot
    }
    Preconditions {
        Holding(client, objToPlace)
    }    
    Effects {
        AtPlace(objToPlace, objLoc)
        !Holding(client, objToPlace) 
    }   
}