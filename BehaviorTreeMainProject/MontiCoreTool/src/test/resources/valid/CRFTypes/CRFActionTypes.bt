// 5. Action Type Definition (General Template)
Define Action PickUpHL {
    ActLevel: HighLevel
    Properties {
        objToPick: Element
        objLoc: Location
        client: Robot
    }
    Preconditions {
        atplace(objToPick, objLoc)
        !holding(client, objToPick)   
    }    
    Effects {
        holding(client, objToPick)
        !atplace(objToPick, objLoc)
    }   
}

Define Action PlaceHL {
    ActLevel: HighLevel
    Properties {
        objToPlace: Element
        objLoc: Location
        client: Robot
    }
    Preconditions {
        holding(client, objToPlace)
    }    
    Effects {
        atplace(objToPlace, objLoc)
        !holding(client, objToPlace)
    }   
}