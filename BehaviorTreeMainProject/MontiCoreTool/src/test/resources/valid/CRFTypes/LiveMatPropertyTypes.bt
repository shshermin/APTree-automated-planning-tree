Define Beam as Element {loc: Location}
Define Plate as Element {loc: Location}
Define Robot as Agent { loc: Location mType: String}
Define VacGripper as Tool {loc:Location isActive:Boolean}
Define FirstPos as Location 

Define NailGripper as Tool {
    isOn: Boolean
}

Define GlueGun as Tool {
    isOn: Boolean
}



Define Stack as Layer {
    level: Integer
    belongsToModule: Module
}

Define Cassette as Module {
    layers: Layer+
}

Define PositionOnRail as Location

Define Equipposition as Location



Define Stackposition as Location
