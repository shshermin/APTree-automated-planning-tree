Define Action PickUpHL {
    ActLevel: HighLevel
    Properties {
        obj: Element
        grabPos: Location
        client: Robot
    }
    Preconditions {
        !robotequipped(client)
        atplace(obj, grabPos)
        !holding(client, obj)
        !positionfree(grabPos)
        clear(obj)
        !stacked(obj)
    }
    Effects {
        holding(client, obj)
        !atplace(obj, grabPos)
        !clear(obj)
        positionfree(grabPos)
        robotequipped(client)
    }
}

// Robot places an object
Define Action PlaceHL {
    ActLevel: HighLevel
    Properties {
        obj: Element
        placePos: Location
        client: Robot
    }
    Preconditions {
        holding(client, obj)
        !clear(obj)
        positionfree(placePos)
    }
    Effects {
        atplace(obj, placePos)
        !holding(client, obj)
        clear(obj)
        !positionfree(placePos)
    }
}

// Robot stacks one object on top of another object
Define Action StackHL {
    ActLevel: HighLevel
    Properties {
        obj1: Element
        obj2: Element
        client: Robot
        pr: Location
        lay: Stack
        mod: Cassette
    }
    Preconditions {
        robotequipped(client)
        holding(client, obj1)
        atplace(obj2, pr)
    }
    Effects {
        ontop(obj1, obj2)
        stacked(obj1)
        !holding(client, obj1)
        atplace(obj1, pr)
        !clear(obj2)
    }
}

// Robot stacks one bigger object on top of multiple objects
Define Action StackonmultipleHL {
    ActLevel: HighLevel
    Properties {
        plate: Element
        client: Robot
        pos: Location
        mod: Cassette
        lay: Stack
    }
    Preconditions {
        holding(client, plate)
        !atplace(plate, pos)
        robotequipped(client)
    }
    Effects {
        atplace(plate, pos)
        clear(plate)
    }
}

// Robot pours glue on top of an object
Define Action GluingPLateHL {
    ActLevel: HighLevel
    Properties {
        obj: Plate
        pos: PositionOnRail
        client: Robot
    }
    Preconditions {
        !robotequipped(client)
        atplace(obj, pos)
        clear(obj)
        !glued(obj)
    }
    Effects {
        glued(obj)
    }
}

Define Action GluingBeamHL {
    ActLevel: HighLevel
    Properties {
        obj: Beam
        pos: PositionOnRail
        client: Robot       
        mod: Cassette
        lay: Stack
    }
    Preconditions {
        !robotequipped(client)
        atplace(obj, pos)
        clear(obj)
        !glued(obj)
    }
    Effects {
        glued(obj)
    }
}

// Robot nails an object
Define Action NailingHL {
    ActLevel: HighLevel
    Properties {
        obj: Element
        pos: PositionOnRail
        client: Robot
    }
    Preconditions {
        robotequipped(client)
        atplace(obj, pos)
        clear(obj)
        !nailed(obj)
    }
    Effects {
        nailed(obj)
    }
}
