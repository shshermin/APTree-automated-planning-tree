

BehaviorTree APTree {
    Root FlowNode Main { 
        All
        AllFlow
        NodeGraph {    
            FlowNode  HandlePlate {
                Decorator DuplicateDecorator
                All 
                AllAction
                
                NodeGraph { 
                          
                          Action PlaceHL PlacePlate1 (plate1 lp1 r1)  {
                       --[Meets]--> PickUpPlate1;
                    }
                          Action PickUpHL PickUpPlate1 (fp1 plate1 r1)
                    
                }
            } 
            FlowNode BeamPlacement {
                PlanningService MyPddlPlanner1 Enhsp2
                Decorator DuplicateDecorator
                All
                AllFlow
                
                NodeGraph {
                    Action PickUpHL PickupBeam1 (fp1 beam1 r1)  {
                       --[Meets]--> PlaceBeam1;
                    }
                    Action PlaceHL PlaceBeam1 (beam1 lp1 r1)  { 
                       --[Meets]--> PickupBeam2;  // ERROR: PickupBeam2 needs !holding, PlaceBeam1 provides atplace + !holding (ok) but...
                    }
                    Action PickUpHL PickupBeam2 (fp2 beam2 r1)  {
                       --[Meets]--> PickupBeam3;  // ERROR: PickUpHL needs !holding, previous PickUpHL provides holding (violation!)
                    }
                    Action PlaceHL PlaceBeam2 (beam2 lp1 r1)
                }
            }
        }
    }
}
