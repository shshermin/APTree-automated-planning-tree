grammar CRFTypesCon extends CRFTypesDef, de.monticore.MCBasics {

////////// ?????? I am not sure why do we get errors if we dont include this world thing!
@Override
World = (PropertyTypeDefinition | Property | PredicateTypeDefinition | ActionTypeDefinition | Beam | Plate | FirstPos | Robot | VacGripper | Holding | AtPlace | NailGripper | GlueGun | Stack | Cassette | PositionOnRail | Equipposition | Stackposition)*;

// === GENERATED RULES (DO NOT EDIT BELOW) ===
symbol Beam extends Element = "Beam" name:Name "(" loc:Location ")";
symbol Plate extends Element = "Plate" name:Name "(" loc:Location ")";
symbol Robot extends Agent = "Robot" name:Name "(" loc:Location mType:Name ")";
symbol VacGripper extends Tool = "VacGripper" name:Name "(" loc:Location isActive:Boolean ")";
symbol FirstPos extends Location = "FirstPos" name:Name "(" ")";
symbol NailGripper extends Tool = "NailGripper" name:Name "(" isOn:Boolean ")";
symbol GlueGun extends Tool = "GlueGun" name:Name "(" isOn:Boolean ")";
symbol Stack extends Layer = "Stack" name:Name "(" level:Integer belongsToModule:Module ")";
symbol Cassette extends Module = "Cassette" name:Name "(" layers:Layer+ ")";
symbol PositionOnRail extends Location = "PositionOnRail" name:Name "(" ")";
symbol Equipposition extends Location = "Equipposition" name:Name "(" ")";
symbol Stackposition extends Location = "Stackposition" name:Name "(" ")";
// === END GENERATED RULES ===


// === GENERATED PREDICATE RULES (DO NOT EDIT BELOW) ===
Holding extends Predicate = "!"? "Holding" "(" item:Name@Element agent:Name@Agent ")";
AtPlace extends Predicate = "!"? "AtPlace" "(" item:Name@Element loc:Name@Location ")";
// === END GENERATED PREDICATE RULES ===


// === GENERATED ACTION RULES (DO NOT EDIT BELOW) ===
  PickUpHL extends PActionNode = "Action" "PickUpHL" name:Name "(" obj:Name@Element grabPos:Name@Location client:Name@Robot ")" ("{" (Decorator | Service)* "}")?  ("@" subtreeAnnotation:Name)?;
  astrule PickUpHL = method public crftypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=crftypesdef._ast.ASTActionLevel.HIGHLEVEL; } return actLevel; } ;

  PlaceHL extends PActionNode = "Action" "PlaceHL" name:Name "(" obj:Name@Element targetPos:Name@Location client:Name@Robot ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
  astrule PlaceHL = method public crftypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=crftypesdef._ast.ASTActionLevel.HIGHLEVEL; } return actLevel; } ;
}