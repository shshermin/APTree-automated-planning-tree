
grammar CRFTypeDef extends BehaviorTree, de.monticore.types.MCBasicTypes {

//////////property definition
// Parameter Type definition
  // 1. Root container
 World = (PropertyTypeDefinition | Property | PredicateTypeDefinition | ActionTypeDefinition)*;

// 2. The Type System (The "Types") including all the allowed types

interface CustomProperty = name:Name;

  
symbol Layer    implements CustomProperty = "Layer" name:Name;
symbol Module   implements CustomProperty = "Module" name:Name ;
  
abstract symbol  Location implements CustomProperty = name:Name;
abstract symbol  Element  implements CustomProperty = name:Name;
abstract symbol Tool     implements CustomProperty = name:Name ;
abstract symbol  Agent    implements CustomProperty = name:Name;

  // definition of a property - accepts any Name as type (validated by CoCos)
     Property = name:Name ":" type:Name ;
 
  // 5. The Dynamic Definition rule
     PropertyTypeDefinition = "define" name:Name "as" superType:Name "{" (Property)* "}";


//////// predicate definition

// Predicate type definition
      PredicateTypeDefinition = "define" "predicatetype" name:Name  "{" (Property)* "}";
//predicateType
////???????????????????? how can I use "!" in the concrete syntax?
      abstract symbol Predicate = ["not"] name:Name;

// predicate Instances
//////???????????? this is a dummy predicate because the Grammar does not allow abstract nonterminals without implementation if it is not a component grammar
      IsAt extends Predicate = "dummy" name:Name;

// Action type definition

abstract PActionNode extends ActionNode = 
    name:Name 
    actLevel: ActionLevel
    ("@" subtreeAnnotation:Name@BehaviorTree)? 
    ("{" (Decorator | Service)* "}")?
    ;


enum ActionLevel = "HIGHLEVEL" | "MIDLEVEL" | "LOWLEVEL";

    ActionTypeDefinition = 
    "Action" typeName:Name "{"
        "acttype:" actLevel:ActionLevel
        "properties" "{" Property* "}"
        "preconditions" "{" preconditions:PredicateRef* "}"
        "effects" "{" effects:PredicateRef* "}"
    "}";

// Simple predicate reference with Name arguments (comma-separated)
PredicateRef = name:Name@Predicate "(" (args:Name ("," args:Name)*)? ")";


 PlaceTimber extends PActionNode = "placetimber";

}