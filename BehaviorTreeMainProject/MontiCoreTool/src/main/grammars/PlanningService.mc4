grammar PlanningService extends ConcreteBT {


  abstract PService extends Service = name:Name planner:Name@Planner;

  PDDLPlannerService extends PService = "PDDLPlanning" "Service" name:Name planner:Name@Planner ;
  
  // 2. Planner hierarchy
  abstract symbol Planner = name:Name;

  PDDLPlanner extends Planner = "PDDLPlanner" name:Name ("domain" domain:Name@Domain)?   ("problem" problem:Name)?;

  symbol Domain = "domain" name:Name "Level" actLev:ActionLevel;


}
