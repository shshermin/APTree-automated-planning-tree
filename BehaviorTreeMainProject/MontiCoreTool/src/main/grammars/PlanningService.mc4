grammar PlanningService extends CRFTypesCon {


  abstract PService extends Service = name:Name planner:Name@Planner;

  PDDLPlannerService extends PService = "PDDLPlanning" "Service" name:Name planner:Name@PDDLPlanner ;
  
  // 2. Planner hierarchy
  abstract symbol Planner = name:Name;

abstract symbol PDDLPlanner extends Planner = "PddlPlanner" name:Name "Domain" domain:Name@Domain   ("Problem" problem:Name)?;
ENHSP extends PDDLPlanner = "PddlPlanner" "Enhsp" name:Name "Domain" domain:Name@Domain   ("Problem" problem:Name)?;

symbol Domain = "Domain" name:Name  "LanguageVersion" language:Name "Level" actLev:ActionLevel;


}
