// Predicate definition

Predicate Holding {
  item : Element
  agent : Agent
}

Predicate AtPlace {
  item : Element
  loc : Location
}


Predicate IsAt {
    myObject : Element
    location : Location
}

Predicate AtTool {
    tool : Tool
    loc : Location
}

Predicate AtAgent {
    agent : Agent
    location : Location
}

Predicate HasTool {
    agent : Agent
    tool : Tool
}


Predicate Clear {
    myObject : Element
}

Predicate OnTop {
    myObject1 : Element
    myObject2 : Element
}

Predicate AllSet {
    lay : Layer
    mod : Module
}

Predicate BelongsToLayer {
    myObject : Element
    lay : Layer
}

Predicate BelongsToModule {
    myObject : Element
    mod : Module
}

Predicate PositionFree {
    pos : Location
}

Predicate Stacked {
    myObject : Element
}

Predicate Glued {
    myObject : Element
}

Predicate Nailed {
    myObject : Element
}

Predicate VGEmpty { client: Name@Agent}
