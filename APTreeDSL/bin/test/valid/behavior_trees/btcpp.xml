#include <behaviortree_cpp/bt_factory.h>
#include "dummy_nodes.h"  // Custom action nodes

// Define the behavior tree in XML
static const char* xml_tree = R"(
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="root_sequence">
      
      <Sequence name="sequence1">
        <PickUp name="pickup-beam1" beam="{beam1}" location="fp1"/>
        <Place name="place-beam1" beam="{beam1}" location="pr1"/>
      </Sequence>

      <Fallback name="fallback1">
        <Sequence name="sequence2">
          <PickUp name="pickup-beam2" beam="{beam2}" location="fp2"/>
          <Place name="place-beam2" beam="{beam2}" location="pr1"/>
        </Sequence>
        
        <Sequence name="Sequence3">
          <PickUp name="pickup-beam3" beam="{beam3}" location="fp3"/>
          <Place name="place-beam3" beam="{beam3}" location="pr1"/>
        </Sequence>
      </Fallback>

    </Sequence>
  </BehaviorTree>
</root>
)";

int main() {
    BT::BehaviorTreeFactory factory;

    // Register custom nodes
    factory.registerNodeType<SayHello>("SayHello");
    factory.registerNodeType<PickUp>("PickUp");
    factory.registerNodeType<Place>("Place");

    // Create the tree from XML
    auto tree = factory.createTreeFromText(xml_tree);

    // Create Beam objects and store them on the blackboard
    Beam beam1{"beam1", 2.5, 10.0};   // id, length, weight
    Beam beam2{"beam2", 3.0, 15.0};
    Beam beam3{"beam3", 1.8, 8.5};

    tree.rootBlackboard()->set("beam1", beam1);
    tree.rootBlackboard()->set("beam2", beam2);
    tree.rootBlackboard()->set("beam3", beam3);

    std::cout << "=== Beams loaded to blackboard ===" << std::endl;

    // Execute the tree
    tree.tickWhileRunning();

    return 0;
}
