
BehaviorTree APTree {
    Root FlowNode Main {
        All
        AllFlow
        NodeGraph {    
            FlowNode  HandlePlate {
                ServicePlanning MyPlannerSrv1 Enhsp Domain:PickAndPlaceHL Problem:PlacePlate1
                All
                AllAction
                NodeGraph {
                    Action PickUpHL PickUpPlate1 (plate1 fp1 r1) @PickUpMLSubtree {
                       --[Meets]--> PlacePlate1;
                    }
                    Action PlaceHL PlacePlate1 (plate1 pr1 r1) 
                }
            } 
            FlowNode BeamPlacement {
                ServicePlanning MyPlannerSrv1 Enhsp Domain:PickAndPlaceHL Problem:handleBeams
                All
                AllAction
                NodeGraph {
                            Action PickUpHL PickUpBeam1 (beam1 fp2 robot1) { 
                                --[Meets]--> PlaceBeam1;
                            }
                            Action PlaceHL PlaceBeam1 (beam1 pr2 r1) 
                            Action PickUpHL PickUpBeam2 (beam2 fp3 r1) { 
                                --[Meets]--> PlaceBeam2;
                            }
                            Action PlaceHL PlaceBeam2 (beam2 pr3 r1) 
                }   
            }
        }
    }
} 