grammar PlanningService extends DomainTypesCon {
 
 PWorld = (Problem| ServicePDDLPlanning | PlannerENHSP | Domain )*;
//planning service
abstract ServicePlanning  extends Service = name:Name planner:Planner;
ServicePDDLPlanning extends ServicePlanning = "ServicePlanning"  name:Name planner:Planner;
  
// Planners
abstract Planner ;
abstract PlannerPDDL extends Planner =  "Domain" ":" domain:Name@Domain   ("Problem" ":" problem:Name@Problem)? ("Config" ":" config:FILEPATH)?;
PlannerENHSP extends PlannerPDDL = "Enhsp"  "Domain" ":" domain:Name@Domain   ("Problem" ":" problem:Name@Problem)? ("Config" ":" config:FILEPATH)?;
PlannerFF extends PlannerPDDL = "FF"  "Domain" ":" domain:Name@Domain   ("Problem" ":" problem:Name@Problem)?;
symbol Domain = "Domain" name:Name  "LanguageVersion" ":" language:Double "Level" ":" actLev:ActionLevel "{" supportedActs:Name@PActionNode ("," supportedActs:Name@PActionNode)* "}";
symbol Problem = "Problem" name:Name;
}


