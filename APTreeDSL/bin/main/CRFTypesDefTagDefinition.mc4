grammar CRFTypesDefTagDefinition extends CRFTypesDef ,de.monticore.tagging.Tags ,BehaviorTreeTagDefinition ,de.monticore.types.MCBasicTypesTagDefinition {
  /* DefaultIdent (using the Name) works too */
   WorldIdentifier implements ModelElementIdentifier  = "[" identifiesElement:World "]" ;
  /* DefaultIdent (using the Name) works too */
   PropertyIdentifier implements ModelElementIdentifier  = "[" identifiesElement:Property "]" ;
  /* DefaultIdent (using the Name) works too */
   PropertyTypeDefinitionIdentifier implements ModelElementIdentifier  = "[" identifiesElement:PropertyTypeDefinition "]" ;
  /* DefaultIdent (using the Name) works too */
   PredicateTypeDefinitionIdentifier implements ModelElementIdentifier  = "[" identifiesElement:PredicateTypeDefinition "]" ;
  /* DefaultIdent (using the Name) works too */
   DummyIdentifier implements ModelElementIdentifier  = "[" identifiesElement:Dummy "]" ;
  /* DefaultIdent (using the Name) works too */
   ActionTypeDefinitionIdentifier implements ModelElementIdentifier  = "[" identifiesElement:ActionTypeDefinition "]" ;
  /* DefaultIdent (using the Name) works too */
   PredicateRefIdentifier implements ModelElementIdentifier  = "[" identifiesElement:PredicateRef "]" ;
  /* DefaultIdent (using the Name) works too */
   PlaceTimberIdentifier implements ModelElementIdentifier  = "[" identifiesElement:PlaceTimber "]" ;
  astrule WorldIdentifier = method public String getIdentifies(){ 
    return "World";

  } 
  ;
  astrule PropertyIdentifier = method public String getIdentifies(){ 
    return "Property";

  } 
  ;
  astrule PropertyTypeDefinitionIdentifier = method public String getIdentifies(){ 
    return "PropertyTypeDefinition";

  } 
  ;
  astrule PredicateTypeDefinitionIdentifier = method public String getIdentifies(){ 
    return "PredicateTypeDefinition";

  } 
  ;
  astrule DummyIdentifier = method public String getIdentifies(){ 
    return "Dummy";

  } 
  ;
  astrule ActionTypeDefinitionIdentifier = method public String getIdentifies(){ 
    return "ActionTypeDefinition";

  } 
  ;
  astrule PredicateRefIdentifier = method public String getIdentifies(){ 
    return "PredicateRef";

  } 
  ;
  astrule PlaceTimberIdentifier = method public String getIdentifies(){ 
    return "PlaceTimber";

  } 
  ;
  start TagUnit;
}
