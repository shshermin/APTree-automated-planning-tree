grammar CRFTypesDefTagSchema extends de.monticore.tagging.TagSchema ,BehaviorTreeTagSchema ,de.monticore.types.MCBasicTypesTagSchema {
   WorldSchemaIdentifier implements ScopeIdentifier  = "World" ;
   PropertySchemaIdentifier implements ScopeIdentifier  = "Property" ;
   PropertyTypeDefinitionSchemaIdentifier implements ScopeIdentifier  = "PropertyTypeDefinition" ;
   PredicateTypeDefinitionSchemaIdentifier implements ScopeIdentifier  = "PredicateTypeDefinition" ;
   DummySchemaIdentifier implements ScopeIdentifier  = "Dummy" ;
   ActionTypeDefinitionSchemaIdentifier implements ScopeIdentifier  = "ActionTypeDefinition" ;
   PredicateRefSchemaIdentifier implements ScopeIdentifier  = "PredicateRef" ;
   PlaceTimberSchemaIdentifier implements ScopeIdentifier  = "PlaceTimber" ;
  start TagSchema;
}
