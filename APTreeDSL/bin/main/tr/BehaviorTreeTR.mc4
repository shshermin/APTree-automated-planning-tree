  // abstract node class
  // flow nodes
  // action nodes
  // services and decorators
  // Fragment definitions (must come before token definitions that use them)
  token LexTFDIGIT
    ='0'..'9' ;

  fragment token LexTFLOWER
    ='a'..'z' ;

  fragment token LexTFUPPER
    ='A'..'Z' ;

  fragment token LexTFALPHA
    ='a'..'z' |'A'..'Z' ;

  fragment token LexTFSYMBOL
    ='-' |'_' |'.' |'/' |'\\' ;

  // Token definitions
  token LexTFDouble
    =('-')? LexTFDIGIT+'.' LexTFDIGIT+;

  token LexTFInteger
    =('-')? LexTFDIGIT+;

  token LexTFFILEPATH
    =(LexTFALPHA|LexTFDIGIT|LexTFSYMBOL)+;

