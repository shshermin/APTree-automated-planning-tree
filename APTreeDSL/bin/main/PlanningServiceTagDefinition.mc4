grammar PlanningServiceTagDefinition extends PlanningService ,de.monticore.tagging.Tags ,CRFTypesConTagDefinition {
  /* DefaultIdent (using the Name) works too */
   PWorldIdentifier implements ModelElementIdentifier  = "[" identifiesElement:PWorld "]" ;
  /* DefaultIdent (using the Name) works too */
   PDDLPlannerServiceIdentifier implements ModelElementIdentifier  = "[" identifiesElement:PDDLPlannerService "]" ;
  /* DefaultIdent (using the Name) works too */
   ENHSPIdentifier implements ModelElementIdentifier  = "[" identifiesElement:ENHSP "]" ;
  /* DefaultIdent (using the Name) works too */
   DomainIdentifier implements ModelElementIdentifier  = "[" identifiesElement:Domain "]" ;
  /* DefaultIdent (using the Name) works too */
   ProblemIdentifier implements ModelElementIdentifier  = "[" identifiesElement:Problem "]" ;
  astrule PWorldIdentifier = method public String getIdentifies(){ 
    return "PWorld";

  } 
  ;
  astrule PDDLPlannerServiceIdentifier = method public String getIdentifies(){ 
    return "PDDLPlannerService";

  } 
  ;
  astrule ENHSPIdentifier = method public String getIdentifies(){ 
    return "ENHSP";

  } 
  ;
  astrule DomainIdentifier = method public String getIdentifies(){ 
    return "Domain";

  } 
  ;
  astrule ProblemIdentifier = method public String getIdentifies(){ 
    return "Problem";

  } 
  ;
  start TagUnit;
}
