grammar PlanningServiceTagDefinition extends PlanningService ,de.monticore.tagging.Tags ,DomainTypesConTagDefinition {
  /* DefaultIdent (using the Name) works too */
   PWorldIdentifier implements ModelElementIdentifier  = "[" identifiesElement:PWorld "]" ;
  /* DefaultIdent (using the Name) works too */
   ServicePDDLPlanningIdentifier implements ModelElementIdentifier  = "[" identifiesElement:ServicePDDLPlanning "]" ;
  /* DefaultIdent (using the Name) works too */
   PlannerENHSPIdentifier implements ModelElementIdentifier  = "[" identifiesElement:PlannerENHSP "]" ;
  /* DefaultIdent (using the Name) works too */
   PlannerFFIdentifier implements ModelElementIdentifier  = "[" identifiesElement:PlannerFF "]" ;
  /* DefaultIdent (using the Name) works too */
   DomainIdentifier implements ModelElementIdentifier  = "[" identifiesElement:Domain "]" ;
  /* DefaultIdent (using the Name) works too */
   ProblemIdentifier implements ModelElementIdentifier  = "[" identifiesElement:Problem "]" ;
  astrule PWorldIdentifier = method public String getIdentifies(){ 
    return "PWorld";

  } 
  ;
  astrule ServicePDDLPlanningIdentifier = method public String getIdentifies(){ 
    return "ServicePDDLPlanning";

  } 
  ;
  astrule PlannerENHSPIdentifier = method public String getIdentifies(){ 
    return "PlannerENHSP";

  } 
  ;
  astrule PlannerFFIdentifier = method public String getIdentifies(){ 
    return "PlannerFF";

  } 
  ;
  astrule DomainIdentifier = method public String getIdentifies(){ 
    return "Domain";

  } 
  ;
  astrule ProblemIdentifier = method public String getIdentifies(){ 
    return "Problem";

  } 
  ;
  start TagUnit;
}
