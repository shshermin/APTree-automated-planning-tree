 grammar BehaviorTree extends  de.monticore.types.MCBasicTypes {
  symbol BehaviorTree = "BehaviorTree" name:Name "{" "Root" root:FlowNode "}";
  // abstract node class
  abstract symbol BTNode = name:Name (Decorator | Service)*; 

  // flow nodes
  abstract  FlowNode extends BTNode = name:Name  (Service | Decorator | children:BTNode)* ;
  Sequence extends FlowNode = "Sequence" name:Name "{" (Service | Decorator | children:BTNode)* "}";
  Parallel extends FlowNode = "Parallel" name:Name "{" (Service | Decorator | children:BTNode)* "}";
 
  // action nodes
  abstract  ActionNode extends BTNode = "Action" name:Name ("{" (Decorator | Service)* "}")? ;
  PickUp extends ActionNode = "Action" name:Name ("{" (Decorator | Service)* "}")?;
  Place extends ActionNode = "Action" name:Name ("{" (Decorator | Service)* "}")?;
 
  // services and decorators
  abstract Service = "Service" name:Name;
  abstract Decorator = "Decorator" name:Name;
  GripEmpty extends Decorator = "Decorator" name:Name;
  CalcDist extends Service = "Service" name:Name;


    // Fragment definitions (must come before token definitions that use them)
  fragment token DIGIT  = '0'..'9';
  fragment token LOWER  = 'a'..'z';
  fragment token UPPER  = 'A'..'Z';
  fragment token ALPHA  = 'a'..'z' | 'A'..'Z';
  fragment token SYMBOL = '-' | '_' | '.' | '/' | '\\';

  // Token definitions
  token Coordinate = ('-')? DIGIT+ ('.' DIGIT+)? ('E' ('-')? DIGIT+)? ',' ('-')? DIGIT+ ('.' DIGIT+)? ('E' ('-')? DIGIT+)? ',' ('-')? DIGIT+ ('.' DIGIT+)? ('E' ('-')? DIGIT+)?;
  token Double  = ('-')? DIGIT+ '.' DIGIT+;
  token Integer = ('-')?  DIGIT+;
  token FILEPATH = (ALPHA | DIGIT | SYMBOL)+;
  token String = '"' ( (~('"' | '\\' | '\r' | '\n')) | ('\\' .) )* '"';

  // Type definitions
  BasicType = Integer | Double | FILEPATH | String | Boolean |Name;

  enum Boolean = "True" | "False";

}








