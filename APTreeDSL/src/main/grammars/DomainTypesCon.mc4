grammar DomainTypesCon extends DomainTypesDef, de.monticore.MCBasics {

// Override required: the concrete grammar must enumerate all concrete symbol types
// so the MontiCore parser can recognize them in the world definition.
@Override
World = ( PropertyTypeDefinition | Property | PredicateTypeDefinition | ActionTypeDefinition | Beam | Plate | FirstPos | Robot | Human | VacGripper | Holding | AtPlace | AtTool | NailGripper | GlueGun | Stack | Cassette | PositionOnRail | EquipPosition | StackPosition | IsAt | AtAgent | HasTool | Clear | OnTop | AllSet | BelongsToLayer | BelongsToModule | PositionFree | Stacked | Glued | Nailed | VgEmpty)*;

// === GENERATED RULES (DO NOT EDIT BELOW) ===
symbol Beam extends Element = "Beam" name:Name "(" loc:Name@Location ")";
symbol Plate extends Element = "Plate" name:Name "(" loc:Name@Location ")";
symbol Robot extends Agent = "Robot" name:Name "(" loc:Name@Location mType:Name ")";
symbol VacGripper extends Tool = "VacGripper" name:Name "(" loc:Name@Location isActive:Boolean ")";
symbol FirstPos extends Location = "FirstPos" name:Name "(" ")";
symbol NailGripper extends Tool = "NailGripper" name:Name "(" loc:Name@Location isActive:Boolean ")";
symbol GlueGun extends Tool = "GlueGun" name:Name "(" loc:Name@Location isActive:Boolean")";
symbol Stack extends Layer = "Stack" name:Name "(" level:Integer belongsToModule:Name@Module ")";
symbol Cassette extends Module = "Cassette" name:Name "(" layers:Name@Layer+ ")";
symbol PositionOnRail extends Location = "PositionOnRail" name:Name "(" ")";
symbol EquipPosition extends Location = "EquipPosition" name:Name "(" ")";
symbol StackPosition extends Location = "StackPosition" name:Name "(" ")";
symbol Human extends Agent = "Human" name:Name "(" loc:Name@Location ")";
// === END GENERATED RULES ===


// === GENERATED PREDICATE RULES (DO NOT EDIT BELOW) ===
Holding extends Predicate = not:["!"]? "Holding" "(" item:Name@Element agent:Name@Agent ")";
AtPlace extends Predicate = not:["!"]? "AtPlace" "(" item:Name@Element loc:Name@Location ")";
IsAt extends Predicate = not:["!"]? "IsAt" "(" myObject:Name@Element location:Name@Location ")";
AtAgent extends Predicate = not:["!"]? "AtAgent" "(" agent:Name@Agent location:Name@Location ")";
HasTool extends Predicate = not:["!"]? "HasTool" "(" agent:Name@Agent tool:Name@Tool ")";
Clear extends Predicate = not:["!"]? "Clear" "(" myObject:Name@Element ")";
OnTop extends Predicate = not:["!"]? "OnTop" "(" myObject1:Name@Element myObject2:Name@Element ")";
AllSet extends Predicate = not:["!"]? "AllSet" "(" lay:Name@Layer mod:Name@Module ")";
BelongsToLayer extends Predicate = not:["!"]? "BelongsToLayer" "(" myObject:Name@Element lay:Name@Layer ")";
BelongsToModule extends Predicate = not:["!"]? "BelongsToModule" "(" myObject:Name@Element mod:Name@Module ")";
PositionFree extends Predicate = not:["!"]? "PositionFree" "(" pos:Name@Location ")";
Stacked extends Predicate = not:["!"]? "Stacked" "(" myObject:Name@Element ")";
Glued extends Predicate = not:["!"]? "Glued" "(" myObject:Name@Element ")";
Nailed extends Predicate = not:["!"]? "Nailed" "(" myObject:Name@Element ")";
VgEmpty extends Predicate = not:["!"]? "VgEmpty" "(" client:Name@Agent ")";
AtTool extends Predicate = not:["!"]? "AtTool" "(" tool:Name@Tool loc:Name@Location ")";
// === END GENERATED PREDICATE RULES ===


// === GENERATED ACTION RULES (DO NOT EDIT BELOW) ===
PickUpHL extends PActionNode = "Action" "PickUpHL" name:Name "(" obj:Name@Element grabPos:Name@Location client:Name@Robot ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule PickUpHL = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.HIGHLEVEL; } return actLevel; } ;

PlaceHL extends PActionNode = "Action" "PlaceHL" name:Name "(" obj:Name@Element placePos:Name@Location client:Name@Robot ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule PlaceHL = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.HIGHLEVEL; } return actLevel; } ;

StackHL extends PActionNode = "Action" "StackHL" name:Name "(" obj1:Name@Element obj2:Name@Element client:Name@Robot pr:Name@Location lay:Name@Stack mod:Name@Cassette ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule StackHL = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.HIGHLEVEL; } return actLevel; } ;

StackOnMultipleHL extends PActionNode = "Action" "StackOnMultipleHL" name:Name "(" plate:Name@Element client:Name@Robot pos:Name@Location mod:Name@Cassette lay:Name@Stack ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule StackOnMultipleHL = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.HIGHLEVEL; } return actLevel; } ;

GluingPlateHL extends PActionNode = "Action" "GluingPlateHL" name:Name "(" obj:Name@Plate pos:Name@PositionOnRail client:Name@Robot ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule GluingPlateHL = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.HIGHLEVEL; } return actLevel; } ;

GluingBeamHL extends PActionNode = "Action" "GluingBeamHL" name:Name "(" obj:Name@Beam client:Name@Robot mod:Name@Cassette lay:Name@Stack ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule GluingBeamHL = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.HIGHLEVEL; } return actLevel; } ;

NailingBeamHL extends PActionNode = "Action" "NailingBeamHL" name:Name "(" obj:Name@Beam client:Name@Robot mod:Name@Cassette lay:Name@Stack ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule NailingBeamHL = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.HIGHLEVEL; } return actLevel; } ;

NailingHL extends PActionNode = "Action" "NailingHL" name:Name "(" obj:Name@Plate client:Name@Robot ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule NailingHL = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.HIGHLEVEL; } return actLevel; } ;

TravelML extends PActionNode = "Action" "TravelML" name:Name "(" client:Name@Robot from:Name@Location to:Name@Location ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule TravelML = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.MIDLEVEL; } return actLevel; } ;

EquipeML extends PActionNode = "Action" "EquipeML" name:Name "(" client:Name@Robot too:Name@Tool ep:Name@EquipPosition ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule EquipeML = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.MIDLEVEL; } return actLevel; } ;

DeequipML extends PActionNode = "Action" "DeequipML" name:Name "(" client:Name@Robot too:Name@Tool ep:Name@EquipPosition ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule DeequipML = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.MIDLEVEL; } return actLevel; } ;

InitializeML extends PActionNode = "Action" "InitializeML" name:Name "(" client:Name@Robot too:Name@Tool ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule InitializeML = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.MIDLEVEL; } return actLevel; } ;

CloseToolML extends PActionNode = "Action" "CloseToolML" name:Name "(" client:Name@Robot too:Name@Tool ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule CloseToolML = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.MIDLEVEL; } return actLevel; } ;

PickUpML extends PActionNode = "Action" "PickUpML" name:Name "(" obj:Name@Element pos:Name@FirstPos client:Name@Robot vg:Name@VacGripper ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule PickUpML = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.MIDLEVEL; } return actLevel; } ;

PlaceML extends PActionNode = "Action" "PlaceML" name:Name "(" obj:Name@Element placepos:Name@Location client:Name@Robot vg:Name@VacGripper ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
