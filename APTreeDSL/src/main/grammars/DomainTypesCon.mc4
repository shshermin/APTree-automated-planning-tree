GluingML extends PActionNode = "Action" "GluingML" name:Name "(" obj:Name@Element pos:Name@PositionOnRail client:Name@Robot gg:Name@GlueGun ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule GluingML = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.MIDLEVEL; } return actLevel; } ;

NailingML extends PActionNode = "Action" "NailingML" name:Name "(" obj:Name@Element pos:Name@PositionOnRail client:Name@Robot ng:Name@NailGripper ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule NailingML = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.MIDLEVEL; } return actLevel; } ;

StackML extends PActionNode = "Action" "StackML" name:Name "(" obj1:Name@Element obj2:Name@Element client:Name@Robot vg:Name@VacGripper pr:Name@PositionOnRail ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule StackML = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.MIDLEVEL; } return actLevel; } ;

StackOnMultipleML extends PActionNode = "Action" "StackOnMultipleML" name:Name "(" plate:Name@Plate client:Name@Robot pos:Name@PositionOnRail vg:Name@VacGripper mod:Name@Cassette lay:Name@Stack ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
