PickUpCassetteML extends PActionNode = "Action" "PickUpCassetteML" name:Name "(" lp:Name@Plate mod:Name@Cassette lay:Name@Stack p:Name@Location client:Name@Robot vg:Name@VacGripper ")" ("{" (Decorator | Service)* "}")? ("@" subtreeAnnotation:Name)? ;
astrule PickUpCassetteML = method public domaintypesdef._ast.ASTActionLevel getActLevel() { if(actLevel==null){ actLevel=domaintypesdef._ast.ASTActionLevel.MIDLEVEL; } return actLevel; } ;

