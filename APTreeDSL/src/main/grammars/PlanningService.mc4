grammar PlanningService extends CRFTypesCon {

  
 PWorld = (Problem| ServicePDDLPlanner | ENHSPPlanner | Domain )*;
//planning service
abstract ServicePlanning  extends Service = name:Name planner:Planner;
ServicePDDLPlanner extends ServicePlanning = "ServicePlanning"  name:Name planner:Planner ;
  
// 2. Planners
abstract symbol Planner = name:Name;

abstract symbol PlannerPDDL extends Planner = "PlannerPddl" name:Name "Domain" ":" domain:Name@Domain   ("Problem" ":" problem:Name@Problem)?;
symbol ENHSPPlanner extends PlannerPDDL = "Enhsp" "Domain" ":" domain:Name@Domain   ("Problem" ":" problem:Name@Problem)?;

symbol Domain = "Domain" name:Name  "LanguageVersion" ":" language:Double "Level" ":" actLev:ActionLevel "{" supportedActs:Name@PActionNode ("," supportedActs:Name@PActionNode)* "}";
symbol Problem = "Problem" name:Name;



}


