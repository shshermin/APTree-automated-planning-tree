
grammar CRFTypesDef extends BehaviorTree, de.monticore.types.MCBasicTypes {
// Parameter Type definition
  // 1. Root container
 World = (PropertyTypeDefinition | Property | PredicateTypeDefinition | ActionTypeDefinition)*;

//  All the allowed custom super types

    interface CustomProperty = name:Name; 
    abstract symbol Layer    implements CustomProperty = name:Name;
    abstract symbol Module   implements CustomProperty = name:Name;
    abstract symbol Text     implements CustomProperty = name:Name; 
    abstract symbol Location implements CustomProperty = name:Name;
    abstract symbol Element  implements CustomProperty = name:Name;
    abstract symbol Tool     implements CustomProperty = name:Name;
    abstract symbol Agent    implements CustomProperty = name:Name;

// definition of a property - accepts any Name as type 
    Property =  isCont:["Cont"]?  name:Name ":" type:BasicType isList:["+"]? isOptional:["?"]?;
    PropertyTypeDefinition = superType:Name  name:Name  ("{" (Property)* "}")?;

// predicate definition
    abstract Predicate = not:["!"]?;
    PredicateTypeDefinition = "Predicate" name:Name  "{" (Property)* "}";

// Action type definition
    abstract symbol PActionNode extends ActionNode = 
    name:Name 
    actLevel: ActionLevel
    ("@" subtreeAnnotation:Name@BehaviorTree)? 
    ("{" (Decorator | Service)* "}")?
    ;

    enum ActionLevel = "HighLevel" | "MidLevel" | "LowLevel";
    ActionTypeDefinition = 
    "Define" "Action" name:Name "{"
        "ActLevel:" actLevel:ActionLevel
        "Properties" "{" Property* "}"
        "Preconditions" "{" precons:PredicateRef* "}"
        "Effects" "{" effects:PredicateRef* "}"
    "}";

// predicate reference with Name arguments (comma-separated)
PredicateRef = not:["!"]? name:Name  "(" (args:Name ("," args:Name)*)? ")";


 PlaceTimber extends PActionNode = "placetimber";
 // predicate Instances
    Dummy extends Predicate = "Dummy" name:Name;



}