Define Action PickUpML {
    ActLevel: MidLevel
    Properties {
        obj: Element
        pos: Firstposition
        client: Robot
        vg: VacuumGripper
    }
    Preconditions {
        hasTool(client, vg)
        activeTool(vg)
        atplace(obj, pos)
        atAgent(client, pos)
        vgempty(client)
        !holding(client, obj) //EID6
        clear(obj)
    }
    Effects {
        holding(client, obj)
        !atplace(obj, pos)
        !vgempty(client)
        !clear(obj)
    }
}
