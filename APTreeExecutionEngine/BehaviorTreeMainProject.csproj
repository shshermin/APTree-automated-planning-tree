<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
<PackageReference Include="MountainGoap" Version="0.4.1" />
    <PackageReference Include="Neo4j.Driver" Version="5.15.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!-- Exclude python_service folder from build -->
  <ItemGroup>
    <Compile Remove="python_service/**" />
    <EmbeddedResource Remove="python_service/**" />
    <Content Remove="python_service/**" />
  </ItemGroup>

  <!-- Exclude the xUnit test project's own folder — otherwise the main project's
       default glob picks up its [Fact]-attributed classes with no xunit reference. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <Content Remove="tests/**" />
  </ItemGroup>

  <!-- The src/Tests folder contains ad-hoc runner code (not a separate test project).
       Exclude it from compilation so the web backend can build/run reliably. -->
  <!-- TEMPORARILY ENABLED TO RUN FULLTREETEST
  <ItemGroup>
    <Compile Remove="src/Tests/**" />
  </ItemGroup>
  -->

  <!-- Exclude MontiCore generated C# artifacts from the backend build.
       They currently introduce a top-level namespace `BehaviorTree` (e.g. `BehaviorTree.Types`)
       which conflicts with the backend's `BehaviorTree` type in the global namespace. -->
  <ItemGroup>
    <Compile Remove="MontiCoreTool/generated_csharp/**" />
    <EmbeddedResource Remove="MontiCoreTool/generated_csharp/**" />
    <Content Remove="MontiCoreTool/generated_csharp/**" />
  </ItemGroup>

</Project>
