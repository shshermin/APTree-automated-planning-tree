{
  "_comment": "Fault injection config for the Demonstrator tree. When PickUpML is active inside a PickUpHL whose InstanceName contains 'stick6', simulate a dropped stick: robot loses grasp, gripper becomes empty, stick becomes free at a new temploc1, and the ML flow node replans with the updated blackboard + PDDL :objects.",
  "Faults": [
    {
      "Id": "drop_stick6_on_pickup",
      "Type": "DropAfterClose",
      "Trigger": {
        "MlActionType": "PickUpML",
        "ParentInstanceContains": "stick6",
        "OnActivationCount": 1
      },
      "Effects": {
        "DroppedObject": "stick6",
        "Robot": "robot1",
        "Gripper": "gripper1",
        "TempLocationName": "temploc1",
        "TempLocationPddlType": "firstposition",
        "TempLocationPosition": [0.5993800000000005, -0.0027, -0.009],
        "RobotFromLocation": "rppickup",
        "RobotToLocation": "rpmanipulate"
      }
    },
    {
      "Id": "blocker_on_stick3",
      "Type": "BlockerOnTop",
      "Trigger": {
        "MlActionType": "TravelML",
        "ParentInstanceContains": "stick3",
        "OnActivationCount": 1
      },
      "Effects": {
        "TargetObject": "stick3",
        "BlockerObject": "stickdummy",
        "BlockerPddlType": "stick",
        "BlockerAtLocation": "temploc2",
        "TempLocationName": "temploc3",
        "TempLocationPddlType": "finalposition",
        "TempLocationPosition": [0.6073699999999999, 0.012, -0.009],
        "RobotFromLocation": "rpmanipulate",
        "RobotToLocation": "rppickup"
      }
    },
    {
      "Id": "dislodge_stick5_after_stack",
      "Type": "DislodgedAfterStack",
      "Trigger": {
        "MlActionType": "StackML",
        "ParentInstanceContains": "stick2",
        "OnActivationCount": 1
      },
      "Effects": {
        "DislodgedObject": "stick5",
        "ReturnToLocation": "initlocstick5",
        "ReturnToLocationPddlType": "firstposition",
        "BaseObject": "table1",
        "StackingObject": "stick2",
        "StackingOnObject": "table1",
        "StackingPosition": "finallocstick2",
        "Robot": "robot1"
      }
    }
  ]
}
